{
    "name": "aloongjerr/filament-seo",
    "description": "A SEO management plugin for Filament applications.",
    "keywords": [
        "aloongjerr",
        "laravel",
        "filamentphp",
        "filament-seo"
    ],
    "homepage": "https://github.com/aloongjerr/filament-seo",
    "support": {
        "issues": "https://github.com/aloongjerr/filament-seo/issues",
        "source": "https://github.com/aloongjerr/filament-seo"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Asyraf Othman",
            "email": "creathink.idea@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-livewire": "^3.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AloongJerr\\FilamentSeo\\": "src/",
            "AloongJerr\\FilamentSeo\\Database\\Factories\\": "database/factories/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AloongJerr\\FilamentSeo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AloongJerr\\FilamentSeo\\FilamentSeoServiceProvider"
            ],
            "aliases": {
                "FilamentSeo": "AloongJerr\\FilamentSeo\\Facades\\FilamentSeo"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
